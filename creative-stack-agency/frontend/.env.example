# Frontend runtime env
# Local: keep VITE_API_URL empty to use Vite proxy (/api -> backend)
VITE_API_URL=
# Base path for GitHub RAW image links used in admin/database seed
# Example: https://raw.githubusercontent.com/<owner>/<repo>/<branch>/frontend/src/assets/images
VITE_GITHUB_IMAGE_BASE=

# Production examples
# VITE_API_URL=https://api.creativestackagency.com
VITE_APP_URL=https://creativestackagency.com
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_ERROR_REPORTING=true
