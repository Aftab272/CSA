# Backend runtime
NODE_ENV=development
PORT=3001

# MongoDB
# Option A: provide full URI
MONGODB_URI=

# Option B: provide split values (used when MONGODB_URI is empty)
MONGODB_USER=YOUR_DB_USER
MONGODB_PASSWORD=YOUR_DB_PASS
MONGODB_CLUSTER=YOUR_CLUSTER.mongodb.net
MONGODB_DB_NAME=creative_stack_agency

# JWT secrets (use long random values in production)
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_64_PLUS_CHARS
JWT_EXPIRE=1h
JWT_REFRESH_SECRET=CHANGE_ME_TO_A_DIFFERENT_LONG_RANDOM_SECRET_64_PLUS_CHARS
JWT_REFRESH_EXPIRE=7d

# CORS allowed origins (comma separated)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
