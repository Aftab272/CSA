# MONGODB_URI: Connection string for MongoDB
MONGODB_URI="mongodb://localhost:27017/creative_stack_agency"

# PORT: Backend server port (default: 3001)
PORT=3001

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRE=1h
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production
JWT_REFRESH_EXPIRE=7d

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:5173,https://creativestackagency.com

# Environment
NODE_ENV=development

# Email Configuration (for future implementation)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Redis Configuration (for future implementation)
REDIS_URL=redis://localhost:6379

# Cloudinary Configuration (for future implementation)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
