# Project environment setup
# Copy values to:
# - backend/.env  (required for backend startup)
# - frontend/.env (optional for frontend runtime overrides)

############################
# Backend (.env)
############################
NODE_ENV=development
PORT=3001
MONGODB_URI=mongodb+srv://YOUR_DB_USER:YOUR_DB_PASS@YOUR_CLUSTER.mongodb.net/creative_stack_agency?retryWrites=true&w=majority
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_64_PLUS_CHARS
JWT_EXPIRE=1h
JWT_REFRESH_SECRET=CHANGE_ME_TO_A_DIFFERENT_LONG_RANDOM_SECRET_64_PLUS_CHARS
JWT_REFRESH_EXPIRE=7d
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

############################
# Frontend (.env)
############################
# Leave empty for Vite proxy in local dev.
# For deployed frontend, point this to backend API URL.
VITE_API_URL=
# Base path for GitHub RAW image links
# Example: https://raw.githubusercontent.com/<owner>/<repo>/<branch>/frontend/src/assets/images
VITE_GITHUB_IMAGE_BASE=
