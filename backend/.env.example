# Port for the backend server (Vite proxies /api to port 3001)
PORT=3001

# Environment: development / production
NODE_ENV=development

# Google Gemini API Key (Get free from https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Allowed origins for CORS (comma separated)
# Example: http://localhost:5173,https://creativestackagency.dev
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://creativestackagency.dev

# Daily / Hourly rate limit per IP (requests per 15 minutes)
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=900000

# Max file upload size in MB (default: 15MB)
MAX_FILE_SIZE_MB=15
