{
  "name": "beemim-backend",
  "version": "1.0.0",
  "description": "Beemim AI Backend - Autonomous AI & Digital Utilities API for Creative Stack Agency",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && npx esbuild src/index.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/index.js && npx esbuild src/index.ts --bundle --platform=node --format=esm --target=node20 --outfile=index.mjs",
    "lint": "tsc --noEmit",
    "start": "node dist/index.js"
  },
  "keywords": [
    "ai",
    "beemim",
    "gemini",
    "csa",
    "study-tools",
    "pdf-tools"
  ],
  "author": "Creative Stack Agency",
  "license": "ISC",
  "dependencies": {
    "@google/generative-ai": "^0.24.0",
    "@supabase/supabase-js": "^2.109.0",
    "@types/ws": "^8.18.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "multer": "^1.4.5-lts.1",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.14.0",
    "@types/pdf-parse": "^1.1.4",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
